# =============================================================================
# Hanover Ski Passport Demonstrator — Environment Template
# =============================================================================
# Copy this file to .env and set the values for your environment.
#   cp .env.example .env
# Then edit .env (it is gitignored).
# =============================================================================

# -----------------------------------------------------------------------------
# Domain (for Admin app links and Caddy routing)
# -----------------------------------------------------------------------------
# Base domain for all app subdomains (e.g. vendor.DOMAIN, vault-a.DOMAIN).
DOMAIN=hanover-demonstrator.example.com

# Optional: base URL for DPP lookup (QR code weblink). When set, ski QR codes encode
# this URL + /p/<ski_id> so scanning opens the central Digital Product Passport page.
# Example: https://bridge.hanover-demonstrator.example.com
# NEXT_PUBLIC_DPP_LOOKUP_BASE=https://bridge.${DOMAIN}

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
# The stack expects a Postgres instance on the Docker network "supabase_default"
# with host name supabase-db. Use your own Supabase or any Postgres.
POSTGRES_HOST=supabase-db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password

# -----------------------------------------------------------------------------
# Supabase (for backends and frontends)
# -----------------------------------------------------------------------------
# Option A — Local Supabase (in-repo stack):
#   1. cp supabase/.env.example supabase/.env and set POSTGRES_PASSWORD, etc.
#   2. Start: docker compose -f supabase/docker-compose.yml -p supabase up -d
#   3. Apply schema: docker exec -i supabase-db psql -U postgres -d postgres < supabase/migrations/001_initial_schema.sql
#   4. Set below: SUPABASE_URL=http://supabase-kong:8000, POSTGRES_* and keys from supabase/.env
#   5. For frontends (browser), set NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000 so the app can reach Kong.
# Option B — External Supabase: use project URL and keys from Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: URL used by frontends in the browser (defaults to SUPABASE_URL). Set to http://localhost:8000 when using local Supabase.
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Auth (all app backends)
# -----------------------------------------------------------------------------
# Shared JWT secret for login tokens. Use a long random string in real use.
JWT_SECRET=change-me

# Optional: per-app users (format: user1:password1,user2:password2).
# If unset, defaults below are used. All apps support demo:demo.
# VENDOR_USERS=demo:demo,vendor:vendor
# VAULT_A_USERS=demo:demo,anna:anna
# VAULT_B_USERS=demo:demo,bob:bob
# SERVICE_USERS=demo:demo,tech:tech
# ADMIN_USERS=demo:demo,admin:admin

# -----------------------------------------------------------------------------
# EDC Connectors (Gaia-X Bridge and EDC management APIs)
# -----------------------------------------------------------------------------
# API key for EDC connector management endpoints. Must match EDC config.
EDC_API_KEY=password

# -----------------------------------------------------------------------------
# AAS / PASSAT Integration (Repair Shop)
# -----------------------------------------------------------------------------
# BaSyx AAS repository URL hosting Atomic ski shells and submodels.
AAS_REPO_URL=https://atomic-ski.passat.srfg.at
# Base URL for carrier data (QR code URLs). Serial is appended as ?sn=<serial>.
AAS_CARRIER_BASE=http://wseqr.amersports.com
# Machine identity sent with the getSkiServiceData operation request.
AAS_MACHINE_TYPE=Jupiter-X-TEST
AAS_MACHINE_NUMBER=1234-1234
